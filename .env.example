# Transit Flow — the one local env file.
#
# Copy to .env at the repo root. client/.env.development.local is a symlink to
# it, so Next.js, docker compose, and a host-run worker all read the same
# values and DATABASE_URL is written down exactly once.
#
#   cp .env.example .env
#   ln -sfn ../.env client/.env.development.local
#
# .env is gitignored. Anything `vercel env pull` writes still lands in
# client/.env.local; the symlinked file outranks it for local development.

# ── App + auth ───────────────────────────────────────────────────────────────
AUTH_URL=http://localhost:3000
AUTH_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Comma-separated allowlists for privileged surfaces (/dashboard). Optional —
# defaults to the historical hardcoded owner.
# OWNER_GITHUB_LOGINS=
# OWNER_EMAILS=

# ── Database ─────────────────────────────────────────────────────────────────
# Neon pooled connection string, used by Next.js and by the worker. Use a Neon
# *branch* for local development rather than a local Postgres — pointing local
# development at a different database than production is how schema drift
# starts. This is the one value you must supply.
DATABASE_URL=

# ── Object storage ───────────────────────────────────────────────────────────
# Defaults match docker-compose.yml (MinIO). In production point these at
# Cloudflare R2 or AWS S3 and drop S3_FORCE_PATH_STYLE.
#
# The two endpoints are NOT interchangeable under compose: the worker reaches
# MinIO by service name, which a browser cannot resolve, while presigned URLs
# handed to the browser must be signed for the host it can reach.
S3_BUCKET=transitflow-gtfs
S3_REGION=us-east-1
S3_ENDPOINT=http://127.0.0.1:9000
S3_PUBLIC_ENDPOINT=http://127.0.0.1:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# The bucket must expose the ETag response header or multipart uploads cannot
# be completed. See docs/architecture/01-ingestion.md §10.

# ── Ingestion ────────────────────────────────────────────────────────────────
# Retry budget per job.
GTFS_JOB_ATTEMPTS=3
# WORKER_POLL_INTERVAL_MS=2000
# WORKER_COPY_BATCH_ROWS=20000
# LOG_LEVEL=info

# ── Client-side ──────────────────────────────────────────────────────────────
# These are pulled by `vercel env pull` into client/.env.local; listed here for
# reference only. Do not duplicate them in .env — a copy here silently outranks
# the pulled value.
#   NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN
#   NEXT_PUBLIC_SITE_URL
